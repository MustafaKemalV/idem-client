<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mustafakemalv</groupId>
    <artifactId>idem-client-spring-boot-starter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>idem-client-spring-boot-starter</name>
    <description>Caller-side idempotency: keep a stable Idempotency-Key across reactive retries for outbound Spring WebClient calls.</description>
    <url>https://github.com/MustafaKemalV/idem-client</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mustafakemalv</id>
            <name>Mustafa Kemal Vural</name>
            <url>https://github.com/MustafaKemalV</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/MustafaKemalV/idem-client</url>
        <connection>scm:git:https://github.com/MustafaKemalV/idem-client.git</connection>
        <developerConnection>scm:git:git@github.com:MustafaKemalV/idem-client.git</developerConnection>
    </scm>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Spring Boot auto-configuration (no full starter: keep the library lean) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- WebClient + ExchangeFilterFunction -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <!-- Reactor core: Mono, Context, retryWhen (used directly, so declared explicitly) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- Nullability annotations (@NullMarked). Arrives transitively with reactor-core, but the
             library uses it directly, so it is declared. CLASS retention: consumers need nothing. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- @ConfigurationProperties IDE metadata -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real WebClient (reactor-netty) in tests, to exercise the filter against a mock server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mock downstream HTTP server for end-to-end adversarial tests.
             standalone bundles a shaded Jetty, isolated from Spring Boot 4.1's Jetty 12. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Ship the licence inside the jar, not only in the repository: a consumer auditing their
                 dependencies looks in the artifact. Note that declaring <resources> replaces the
                 parent's, which filtered application*.yml/properties. This library has none; add the
                 filtered entry back before ever putting one here. -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 23 and later no longer run annotation processors discovered on the
                         classpath unless asked. Without this, spring-boot-configuration-processor is
                         declared, sits on the classpath, and silently produces nothing, so the
                         idem-client.* properties have no IDE metadata at all. A test asserts the
                         generated file exists, because a silent no-op is exactly how this got missed. -->
                    <proc>full</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Keep the checks that catch real breakage (a dangling @link, malformed HTML)
                         and drop the one that demands @param on every parameter of every method,
                         which for this API only restates the prose above it. Not "none": silencing
                         doclint entirely would also hide a broken reference. -->
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- A stable module name for consumers on the module path, so adopting JPMS
                                 later cannot change the name they already compiled against. -->
                            <Automatic-Module-Name>io.github.mustafakemalv.idemclient</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Everything the Maven Central Portal requires, kept out of the everyday build: a plain
             `mvn verify` must not ask for a GPG passphrase. CI runs `mvn -Prelease -DskipTests package`
             so this path is exercised before a release depends on it. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <!-- Pinned: unlike source and javadoc, this one is not managed by the parent,
                             so Maven resolved it on its own and warned that it threatens build
                             stability. The plugin that signs release artifacts is the last one whose
                             version should be decided by whatever happens to be newest. -->
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
