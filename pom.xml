<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mustafakemalv</groupId>
    <artifactId>idem-client-spring-boot-starter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>idem-client-spring-boot-starter</name>
    <description>Caller-side idempotency: keep a stable Idempotency-Key across reactive retries for outbound Spring WebClient calls.</description>
    <url>https://github.com/MustafaKemalV/idem-client</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mustafakemalv</id>
            <name>Mustafa Kemal Vural</name>
            <url>https://github.com/MustafaKemalV</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/MustafaKemalV/idem-client</url>
        <connection>scm:git:https://github.com/MustafaKemalV/idem-client.git</connection>
        <developerConnection>scm:git:git@github.com:MustafaKemalV/idem-client.git</developerConnection>
    </scm>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Spring Boot auto-configuration (no full starter: keep the library lean) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- WebClient + ExchangeFilterFunction -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <!-- Reactor core: Mono, Context, retryWhen (used directly, so declared explicitly) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- @ConfigurationProperties IDE metadata -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real WebClient (reactor-netty) in tests, to exercise the filter against a mock server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mock downstream HTTP server for end-to-end adversarial tests.
             standalone bundles a shaded Jetty, isolated from Spring Boot 4.1's Jetty 12. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
